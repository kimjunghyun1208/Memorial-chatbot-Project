from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QTextEdit, 
    QLineEdit, QPushButton, QLabel, QFrame
)
from PyQt6.QtCore import QThread, pyqtSignal, QTimer, Qt, QObject
import sys
import time

# =======================================================================
# [1] 딥러닝 작업자 스레드 (DL Worker Thread)
# =======================================================================
class DLWorker(QThread):
    # 작업 완료 시 챗봇 응답을 GUI로 보내기 위한 시그널 (Signal) 정의
    response_ready = pyqtSignal(str)

    def __init__(self, user_message: str, chat_history: list):
        super().__init__()
        self.user_message = user_message
        self.chat_history = chat_history # 문맥 유지를 위한 대화 기록
        self.model_status = "Loaded" 

    def run(self):
        """
        이 메서드 안에서 로컬 딥러닝 모델을 로드하고 추론합니다.
        """
        if self.model_status == "Error":
            self.response_ready.emit("[오류] 모델 로딩에 실패했습니다. 경로를 확인하세요.")
            return

        print(f"DLWorker: 사용자 입력 처리 중... ({self.user_message})")
        
        try:
            # 1. 실제 모델 추론 (Inference) 시뮬레이션
            # 이 시간 동안 GUI는 멈추지 않습니다.
            time.sleep(3) 

            # 2. 챗봇 페르소나 답변 생성 (실제 모델 응답으로 대체)
            if "프로젝트" in self.user_message or "팀원" in self.user_message:
                bot_response = "다크 모드 적용은 시인성 개선에 매우 좋은 판단입니다. 이제 모델 통합에 집중합시다."
            elif "엔터" in self.user_message:
                bot_response = "네, 이제 전송 버튼 없이 엔터 키만으로도 메시지 전송이 가능합니다. 사용자 경험이 개선되었습니다."
            else:
                bot_response = f"페르소나의 말투로 답변합니다: 다크 모드에서도 완벽하게 보입니다. '{self.user_message}' 메시지는 확실히 처리되었습니다."
            
        except Exception as e:
            bot_response = f"[DL 모델 오류] 추론 중 예상치 못한 문제 발생: {str(e)}"

        # 3. GUI 스레드에 답변을 전달 (안전한 방식)
        self.response_ready.emit(bot_response)


# =======================================================================
# [2] GUI 애플리케이션 클래스 (다크 모드 적용)
# =======================================================================
class AIChatBotGUI(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("졸업 작품 - 페르소나 챗봇 (최종 GUI 프레임워크)")
        self.setGeometry(200, 200, 700, 750)
        self.current_worker = None
        self.chat_history = [] # 대화 문맥 저장을 위한 리스트
        self.init_ui()

    def init_ui(self):
        # 🟢 QSS: 전체 폰트 및 배경 설정 
        self.setStyleSheet("""
            QWidget {
                background-color: #1e1e1e; /* 🌑 전체 배경을 검정 계열로 변경 */
                font-family: 'Malgun Gothic', '맑은 고딕', sans-serif;
                color: #ecf0f1; /* 기본 텍스트 색상을 밝게 설정 */
            }
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(15, 15, 15, 15)
        layout.setSpacing(10)

        # 타이틀 위젯
        title_label = QLabel("✨ 페르소나 챗봇 GUI 시연")
        title_label.setAlignment(Qt.AlignmentFlag.AlignCenter) 
        title_label.setStyleSheet("""
            QLabel {
                font-size: 28px; 
                font-weight: 600; 
                color: #3498db; /* 타이틀 색상 강조 */
                padding: 10px;
            }
        """)
        layout.addWidget(title_label)

        # 채팅 출력창 (QSS로 디자인 강화)
        self.chat_output = QTextEdit()
        self.chat_output.setReadOnly(True)
        self.chat_output.setStyleSheet("""
            QTextEdit {
                background-color: #2c2c2c; /* 채팅창 배경을 어둡게 */
                border: 1px solid #3a3a3a; 
                padding: 15px; 
                border-radius: 15px;
                font-size: 15px;
                color: #ecf0f1; /* 텍스트 색상을 밝게 */
                line-height: 1.5;
            }
        """)
        layout.addWidget(self.chat_output)
        
        # 상태 표시창
        self.status_label = QLabel("🟢 AI 모델 준비 완료. 질문을 입력하세요. (엔터키 전송)")
        self.status_label.setStyleSheet("color: #2ecc71; padding-top: 5px; font-weight: bold;") # 상태 표시 색상도 밝게 변경
        layout.addWidget(self.status_label)

        # 입력 컨테이너 (버튼 없이 입력창만 포함)
        input_container = QFrame()
        input_layout = QVBoxLayout(input_container)
        input_layout.setContentsMargins(0, 0, 0, 0)
        input_layout.setSpacing(8)

        # 🚀 핵심: 사용자 입력창
        self.chat_input = QLineEdit()
        self.chat_input.setPlaceholderText("메시지를 입력하고 엔터 키를 누르세요...")
        self.chat_input.returnPressed.connect(self.send_message) 
        self.chat_input.setStyleSheet("""
            QLineEdit {
                padding: 12px; 
                border: 2px solid #3498db; 
                border-radius: 20px;
                font-size: 16px;
                background-color: #3c3c3c; /* 입력창 배경을 어둡게 */
                color: #ecf0f1; /* 입력 텍스트 색상을 밝게 */
            }
            QLineEdit:disabled {
                background-color: #4a4a4a; /* 비활성화 시 더 어둡게 */
            }
        """)
        input_layout.addWidget(self.chat_input)

        layout.addWidget(input_container)
        
        # 초기 환영 메시지
        self.chat_output.append(self._format_bot_message("안녕하세요! 저는 졸업 작품 페르소나 챗봇의 GUI입니다. 다크 모드가 적용되었습니다."))


    def send_message(self):
        """ 엔터 키를 눌렀을 때 호출되어 메시지를 전송하고 DLWorker를 시작합니다. """
        user_msg = self.chat_input.text().strip()
        # 입력이 없거나, 이미 작업 스레드가 실행 중이면 무시
        if not user_msg or (self.current_worker and self.current_worker.isRunning()):
            return

        # 1. 사용자 메시지 출력 (HTML 말풍선 사용)
        self.chat_output.append(self._format_user_message(user_msg))
        self.chat_input.clear()
        
        # 2. 대화 기록에 추가
        self.chat_history.append({"role": "user", "content": user_msg})

        # 3. GUI 비활성화 및 상태 업데이트 (비동기 처리 시작 알림)
        self.chat_input.setEnabled(False) 
        self.status_label.setText("⏳ 딥러닝 모델이 답변을 생성 중입니다...")
        
        # 4. DLWorker 스레드 시작
        self.current_worker = DLWorker(user_msg, self.chat_history) 
        self.current_worker.response_ready.connect(self.handle_response)
        self.current_worker.start()
        self.chat_output.ensureCursorVisible() # 자동 스크롤

    def handle_response(self, response: str):
        """ DLWorker로부터 최종 응답을 받아 GUI에 표시하는 슬롯 (Slot)입니다. """
        
        # 1. GUI 복구
        self.chat_input.setEnabled(True) 
        self.status_label.setText("✅ 답변 수신 완료. 새로운 메시지를 입력하세요.")

        # 2. 대화 기록에 추가
        self.chat_history.append({"role": "bot", "content": response})

        # 3. 타이핑 효과로 출력
        self.display_typing_effect(response)
        
        self.current_worker = None
        self.chat_output.ensureCursorVisible()

    # --- HTML 말풍선 생성 헬퍼 함수 ---
    def _format_user_message(self, msg: str) -> str:
        """ 사용자 메시지 (우측 정렬, 파란색 배경) HTML 포맷 """
        # 사용자 말풍선은 다크 모드에서도 대비가 높은 파란색으로 유지
        return f"""
        <div style="text-align: right; margin-bottom: 10px;">
            <div style="
                display: inline-block; 
                background-color: #3498db; 
                color: white; 
                padding: 10px 15px; 
                border-radius: 18px 18px 3px 18px; 
                max-width: 70%;
                font-size: 15px;
            ">
                {msg}
            </div>
        </div>
        """

    def _format_bot_message(self, msg: str) -> str:
        """ 챗봇 메시지 (좌측 정렬, 어두운 회색 배경) HTML 포맷 """
        # 챗봇 말풍선 배경을 어두운 계열로 변경하고 텍스트는 밝게 변경
        return f"""
        <div style="text-align: left; margin-bottom: 10px;">
            <div style="
                display: inline-block; 
                background-color: #3a3a3a; /* 챗봇 배경색을 어두운 계열로 변경 */
                color: #ecf0f1; /* 텍스트 색상을 밝게 유지 */
                padding: 10px 15px; 
                border-radius: 18px 18px 18px 3px; 
                max-width: 70%;
                font-size: 15px;
            ">
                {msg}
            </div>
        </div>
        """
    
    # --- 타이핑 효과 로직 ---
    def display_typing_effect(self, message: str):
        """
        QTimer를 사용하여 챗봇 메시지를 한 글자씩 출력하는 효과를 냅니다.
        """
        self.full_message = message
        self.char_index = 0
        
        # 기존 타이머가 있으면 중지
        if hasattr(self, '_timer') and self._timer.isActive():
            self._timer.stop()
            
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._add_char)
        self._timer.start(20) # 20ms 간격으로 문자 추가

    def _add_char(self):
        if self.char_index < len(self.full_message):
            char = self.full_message[self.char_index]
            
            cursor = self.chat_output.textCursor()
            cursor.movePosition(cursor.MoveOperation.End)
            
            if self.char_index == 0:
                # 첫 문자일 때: 임시 말풍선 HTML을 생성하여 append
                temp_msg = self._format_bot_message(char)
                self.chat_output.append(temp_msg)
            else:
                # 이후 문자일 때: 마지막 텍스트 블록에 문자 삽입
                cursor.insertText(char)
            
            self.char_index += 1
            self.chat_output.ensureCursorVisible() # 자동 스크롤
        else:
            # 타이핑 완료 후 타이머 정지
            self._timer.stop()
            del self._timer
            self.chat_output.ensureCursorVisible()


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = AIChatBotGUI()
    window.show()
    sys.exit(app.exec())
